# IA Analisadora - Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Diretório de dados
DATA_DIR=data

# Diretório de saída de relatórios
REPORTS_DIR=data/reports

# Caminho da base de conhecimento (grafo)
KNOWLEDGE_DB=data/conhecimento

# Diretório de logs
LOG_DIR=data/logs

# Cache distribuído (Redis)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Configurações de OCR
TESSERACT_CMD=tesseract
OCR_DPI=300
OCR_LANG=por

# Configurações de NLP
SPACY_MODEL=pt_core_news_lg
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Configurações de rede
REQUEST_TIMEOUT=30
VERIFY_SSL=false

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Configurações de detecção de anomalias
LIMITE_SUPERFATURAMENTO_DESVIOS=3.0
LIMITE_EMPRESA_NOVA_DIAS=180
LIMITE_FRACIONAMENTO_DIAS=30
LIMITE_FRACIONAMENTO_VALOR=50000
LIMITE_CAPITAL_SOCIAL_MINIMO=10000

# Logging
LOG_LEVEL=INFO

# AI Providers - API Keys

# NVIDIA (DeepSeek models via NVIDIA API)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# HuggingFace (Inference API)
HF_TOKEN=hf-your-huggingface-token-here
HF_MODEL=meta-llama/Llama-3.1-70B-Instruct

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google (Gemini)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-pro

# Cohere
COHERE_API_KEY=your-cohere-api-key-here
COHERE_MODEL=command

# OpenRouter (Multi-provider - access to 100+ models)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-3-opus

# Groq (Ultra-fast inference)
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=llama3-70b-8192

# Together AI
TOGETHER_API_KEY=your-together-key-here
TOGETHER_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Mistral AI
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_MODEL=mistral-large-latest

# Ollama (Local - requires Ollama installed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Modelo de IA padrão para análise
# Opções: nvidia, huggingface, openai, anthropic, google, cohere, openrouter, groq, together, mistral, ollama, local (spaCy)
AI_PROVIDER=nvidia
AI_MODEL=deepseek-ai/deepseek-v4-flash

# === APIs Governamentais ===

# CGU - Portal da Transparência (CEIS/CNEP)
# Cadastre em: https://api.portaldatransparencia.gov.br/
CGU_API_KEY=sua-chave-cgu-aqui

# PNCP - Portal Nacional de Contratações Públicas
# API pública (não requer chave)
# PNCP_API_URL=https://pncp.gov.br/api/consulta

# Receita Federal - Consulta CNPJ
# API pública via receitaws.com.br (não requer chave)
# Limitação: 3 consultas por minuto (gratuito)
# Para mais consultas: https://receitaws.com.br/api

# TCU - Tribunal de Contas da União
# API pública (não requer chave)
# TCU_API_URL=https://contas.tcu.gov.br/api

# SICONFI - Finanças Municipais
# API pública (não requer chave)
# SICONFI_API_URL=https://apidatalake.tesouro.gov.br/ords/siconfi

# DOU - Diário Oficial da União
# API pública via Querido Diário (não requer chave)
# DOU_API_URL=https://queridodiario.ok.org.br/api

# Painel de Preços - Governo Federal
# API pública (não requer chave)
# PAINEIS_PRECOS_API_URL=https://paineis.preco.governo.digital
